{
  "_version": "1.49.0",
  "sap.app": {
    "id": "sap.payment.app",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/payment/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://money-bills"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "pageMode": "Replace",
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "sap.payment.app.i18n.i18n",
          "supportedLocales": ["", "vi", "en"],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "PaymentRequestsList",
          "target": "PaymentRequestsList"
        },
        {
          "pattern": "PaymentRequests({key}):?query:",
          "name": "PaymentRequestsObjectPage",
          "target": "PaymentRequestsObjectPage"
        }
      ],
      "targets": {
        "PaymentRequestsList": {
          "type": "Component",
          "id": "PaymentRequestsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/PaymentRequests",
              "entitySet": "PaymentRequests",
              "navigation": {
                "PaymentRequests": {
                  "detail": {
                    "route": "PaymentRequestsObjectPage"
                  }
                }
              }
            }
          }
        },
        "PaymentRequestsObjectPage": {
          "type": "Component",
          "id": "PaymentRequestsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/PaymentRequests",
              "entitySet": "PaymentRequests"
            }
          }
        }
      }
    }
  }
}
