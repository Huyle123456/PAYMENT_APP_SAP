<mvc:View
    controllerName="sap.payment.app.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <uxap:ObjectPageLayout
        id="objectPageLayoutDetail"
        showTitleInHeaderContent="true"
        alwaysShowContentHeader="false"
        preserveHeaderStateOnScroll="false"
        headerContentPinnable="true"
        isChildPage="true"
        busy="{detailView>/busy}">

        <!-- Dynamic Header Title -->
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <Title text="{detailView>/data/requestNo}" wrapping="true" level="H2"/>
                </uxap:expandedHeading>

                <uxap:snappedHeading>
                    <FlexBox fitContainer="true" alignItems="Center">
                        <Title text="{detailView>/data/requestNo}" wrapping="true"/>
                    </FlexBox>
                </uxap:snappedHeading>

                <uxap:expandedContent>
                    <Text text="{detailView>/data/description}"/>
                </uxap:expandedContent>

                <uxap:snappedContent>
                    <Text text="{detailView>/data/description}"/>
                </uxap:snappedContent>

                <uxap:actions>
                    <!-- Submit for BPA Approval -->
                    <Button
                        visible="{= ${detailView>/data/status} === 'DRAFT' || ${detailView>/data/status} === 'REJECTED' }"
                        text="{i18n>btn.submitApproval}"
                        type="Emphasized"
                        icon="sap-icon://paper-plane"
                        press=".onSubmitApprovalPress"/>

                    <!-- BPA Approve -->
                    <Button
                        visible="{= ${detailView>/data/status} === 'IN_APPROVAL' || ${detailView>/data/status} === 'SUBMITTED' }"
                        text="{i18n>btn.approve}"
                        type="Accept"
                        icon="sap-icon://accept"
                        press=".onApprovePress"/>

                    <!-- BPA Reject -->
                    <Button
                        visible="{= ${detailView>/data/status} === 'IN_APPROVAL' || ${detailView>/data/status} === 'SUBMITTED' }"
                        text="{i18n>btn.reject}"
                        type="Reject"
                        icon="sap-icon://decline"
                        press=".onRejectPress"/>

                    <!-- Post to S/4HANA via CPI -->
                    <Button
                        visible="{= ${detailView>/data/status} === 'APPROVED' }"
                        text="{i18n>btn.postToS4Hana}"
                        type="Emphasized"
                        icon="sap-icon://supplier"
                        press=".onPostToS4Press"/>

                    <!-- Full Workflow Simulation -->
                    <Button
                        text="{i18n>btn.simulateFullFlow}"
                        icon="sap-icon://simulate"
                        press=".onSimulateFullWorkflowPress"/>

                    <!-- Refresh -->
                    <Button
                        icon="sap-icon://refresh"
                        tooltip="{i18n>btn.refresh}"
                        press=".onRefresh"/>
                </uxap:actions>

                <uxap:navigationActions>
                    <Button
                        icon="sap-icon://nav-back"
                        tooltip="{i18n>btn.back}"
                        press=".onNavBack"/>
                </uxap:navigationActions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <!-- Header Content: Key Status & Facets -->
        <uxap:headerContent>
            <FlexBox wrap="Wrap" fitContainer="true" alignItems="Stretch">
                <!-- Status & Criticality -->
                <VBox class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                    <Label text="{i18n>label.paymentRequest.status}"/>
                    <ObjectStatus
                        class="sapMObjectStatusLarge"
                        text="{
                            path: 'detailView>/data/status',
                            formatter: '.formatter.statusText'
                        }"
                        state="{
                            path: 'detailView>/data/status',
                            formatter: '.formatter.statusState'
                        }"
                        icon="{
                            path: 'detailView>/data/status',
                            formatter: '.formatter.statusIcon'
                        }"/>
                </VBox>

                <!-- Total Amount -->
                <VBox class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                    <Label text="{i18n>label.paymentRequest.totalAmount}"/>
                    <ObjectNumber
                        number="{
                            parts: [
                                {path: 'detailView>/data/totalAmount'},
                                {path: 'detailView>/data/currency_code'}
                            ],
                            formatter: '.formatter.formatCurrency'
                        }"
                        state="Success"
                        emphasized="true"/>
                </VBox>

                <!-- Vendor & Company -->
                <VBox class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                    <Label text="{i18n>label.paymentRequest.vendor}"/>
                    <Text text="{detailView>/data/vendor/name} ({detailView>/data/vendor_code})"/>
                    <Label text="{i18n>label.paymentRequest.companyCode}" class="sapUiTinyMarginTop"/>
                    <Text text="{detailView>/data/companyCode/name} ({detailView>/data/companyCode_code})"/>
                </VBox>

                <!-- Due Date & Workflow ID -->
                <VBox class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                    <Label text="{i18n>label.paymentRequest.dueDate}"/>
                    <Text text="{
                        path: 'detailView>/data/dueDate',
                        formatter: '.formatter.formatDate'
                    }"/>
                    <Label text="{i18n>label.paymentRequest.workflowInstanceId}" class="sapUiTinyMarginTop"/>
                    <Text text="{= ${detailView>/data/workflowInstanceId} || '—' }"/>
                </VBox>

                <!-- S4 Supplier Invoice -->
                <VBox class="sapUiMediumMarginEnd sapUiTinyMarginBottom" visible="{= !!${detailView>/data/sapSupplierInvoiceNo} }">
                    <Label text="{i18n>label.paymentRequest.sapSupplierInvoiceNo}"/>
                    <ObjectStatus
                        text="{detailView>/data/sapSupplierInvoiceNo}"
                        state="Success"
                        icon="sap-icon://supplier"/>
                    <Label text="{i18n>label.paymentRequest.sapFiscalYear} / {i18n>label.paymentRequest.sapPostingDate}" class="sapUiTinyMarginTop"/>
                    <Text text="{detailView>/data/sapFiscalYear} / {
                        path: 'detailView>/data/sapPostingDate',
                        formatter: '.formatter.formatDate'
                    }"/>
                </VBox>

                <!-- Rejection Reason if any -->
                <VBox class="sapUiMediumMarginEnd sapUiTinyMarginBottom" visible="{= !!${detailView>/data/rejectionReason} }">
                    <Label text="{i18n>label.paymentRequest.rejectionReason}"/>
                    <ObjectStatus
                        text="{detailView>/data/rejectionReason}"
                        state="Error"
                        icon="sap-icon://alert"/>
                </VBox>
            </FlexBox>
        </uxap:headerContent>

        <!-- Sections -->
        <uxap:sections>
            <!-- Section 1: General Information -->
            <uxap:ObjectPageSection titleUppercase="false" title="{i18n>title.paymentRequest.header}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="{i18n>title.paymentRequest.header}">
                        <uxap:blocks>
                            <form:SimpleForm
                                layout="ResponsiveGridLayout"
                                labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                                adjustLabelSpan="false"
                                emptySpanXL="2" emptySpanL="2" emptySpanM="0" emptySpanS="0"
                                columnsXL="2" columnsL="2" columnsM="1"
                                singleContainerFullSize="false">
                                <form:content>
                                    <core:Title text="General Information"/>
                                    <Label text="{i18n>label.paymentRequest.requestNo}"/>
                                    <Text text="{detailView>/data/requestNo}"/>

                                    <Label text="{i18n>label.paymentRequest.description}"/>
                                    <Text text="{detailView>/data/description}"/>

                                    <Label text="{i18n>label.paymentRequest.companyCode}"/>
                                    <Text text="{detailView>/data/companyCode/name} ({detailView>/data/companyCode_code})"/>

                                    <Label text="{i18n>label.paymentRequest.vendor}"/>
                                    <Text text="{detailView>/data/vendor/name} ({detailView>/data/vendor_code})"/>

                                    <Label text="{i18n>label.paymentRequest.requestDate}"/>
                                    <Text text="{
                                        path: 'detailView>/data/requestDate',
                                        formatter: '.formatter.formatDate'
                                    }"/>

                                    <Label text="{i18n>label.paymentRequest.dueDate}"/>
                                    <Text text="{
                                        path: 'detailView>/data/dueDate',
                                        formatter: '.formatter.formatDate'
                                    }"/>

                                    <Label text="{i18n>label.paymentRequest.paymentMethod}"/>
                                    <Text text="{detailView>/data/paymentMethod/name} ({detailView>/data/paymentMethod_code})"/>

                                    <core:Title text="S/4HANA &amp; BPA Workflow Integration"/>
                                    <Label text="{i18n>label.paymentRequest.workflowInstanceId}"/>
                                    <Text text="{= ${detailView>/data/workflowInstanceId} || '—' }"/>

                                    <Label text="{i18n>label.paymentRequest.sapSupplierInvoiceNo}"/>
                                    <Text text="{= ${detailView>/data/sapSupplierInvoiceNo} || '—' }"/>

                                    <Label text="{i18n>label.paymentRequest.sapFiscalYear}"/>
                                    <Text text="{= ${detailView>/data/sapFiscalYear} || '—' }"/>

                                    <Label text="{i18n>label.paymentRequest.sapPostingDate}"/>
                                    <Text text="{
                                        path: 'detailView>/data/sapPostingDate',
                                        formatter: '.formatter.formatDate'
                                    }"/>

                                    <Label text="{i18n>label.paymentRequest.createdAt}"/>
                                    <Text text="{detailView>/data/createdAt}"/>

                                    <Label text="{i18n>label.paymentRequest.createdBy}"/>
                                    <Text text="{detailView>/data/createdBy}"/>
                                </form:content>
                            </form:SimpleForm>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Section 2: End-to-End Architecture Workflow (Figure 1 Alignment) -->
            <uxap:ObjectPageSection titleUppercase="false" title="{i18n>title.paymentRequest.workflow}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="Architecture Steps Execution">
                        <uxap:blocks>
                            <List mode="None" showSeparators="All">
                                <StandardListItem
                                    title="1. S/4HANA Master Data"
                                    description="Replicate Vendors, Company Codes, G/L Accounts, Cost Centers"
                                    icon="sap-icon://database"
                                    info="Replicated"
                                    infoState="Success"/>
                                <StandardListItem
                                    title="2. SAP CAP &amp; Fiori App"
                                    description="Create Payment Request &amp; Validation"
                                    icon="sap-icon://ui-notifications"
                                    info="{= ${detailView>/currentStepIndex} >= 1 ? 'Created' : 'Pending' }"
                                    infoState="{= ${detailView>/currentStepIndex} >= 1 ? 'Success' : 'None' }"/>
                                <StandardListItem
                                    title="3. SAP Event Mesh"
                                    description="Topic: sap/payment/v1/PaymentRequest/Submitted"
                                    icon="sap-icon://connected"
                                    info="{= ${detailView>/currentStepIndex} >= 3 ? 'Emitted' : 'Pending' }"
                                    infoState="{= ${detailView>/currentStepIndex} >= 3 ? 'Success' : 'None' }"/>
                                <StandardListItem
                                    title="4. BPA Approval Stage"
                                    description="{= ${detailView>/data/status} === 'REJECTED' ? ('Rejected: ' + ${detailView>/data/rejectionReason}) : 'Financial multi-level workflow' }"
                                    icon="sap-icon://approvals"
                                    info="{= ${detailView>/data/status} === 'REJECTED' ? 'Rejected' : (${detailView>/data/status} === 'APPROVED' || ${detailView>/data/status} === 'POSTED' ? 'Approved' : (${detailView>/data/status} === 'IN_APPROVAL' ? 'In Review' : 'Draft')) }"
                                    infoState="{= ${detailView>/data/status} === 'REJECTED' ? 'Error' : (${detailView>/data/status} === 'APPROVED' || ${detailView>/data/status} === 'POSTED' ? 'Success' : (${detailView>/data/status} === 'IN_APPROVAL' ? 'Warning' : 'None')) }"/>
                                <StandardListItem
                                    title="5. SAP Integration Suite (CPI)"
                                    description="Transform and dispatch OData API to S/4HANA"
                                    icon="sap-icon://integration-hub"
                                    info="{= ${detailView>/currentStepIndex} >= 5 ? 'Processed' : 'Pending' }"
                                    infoState="{= ${detailView>/currentStepIndex} >= 5 ? 'Success' : 'None' }"/>
                                <StandardListItem
                                    title="6. S/4HANA Supplier Invoice &amp; CAP Status"
                                    description="{= ${detailView>/data/status} === 'POSTED' ? ('Supplier Invoice: ' + ${detailView>/data/sapSupplierInvoiceNo} + ' / FY ' + ${detailView>/data/sapFiscalYear}) : 'Awaiting S/4HANA Posting' }"
                                    icon="sap-icon://supplier"
                                    info="{= ${detailView>/data/status} === 'POSTED' ? 'POSTED' : 'Not Posted' }"
                                    infoState="{= ${detailView>/data/status} === 'POSTED' ? 'Success' : 'None' }"/>
                            </List>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Section 3: Cost Allocation & Items Table -->
            <uxap:ObjectPageSection titleUppercase="false" title="{i18n>title.paymentRequest.items}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="Line Items">
                        <uxap:blocks>
                            <Table
                                items="{detailView>/items}"
                                noDataText="No line items found.">
                                <headerToolbar>
                                    <Toolbar>
                                        <Title text="Items ({= ${detailView>/items}.length })" level="H4"/>
                                    </Toolbar>
                                </headerToolbar>
                                <columns>
                                    <Column width="4rem">
                                        <Text text="{i18n>label.item.itemNo}"/>
                                    </Column>
                                    <Column width="11rem">
                                        <Text text="{i18n>label.item.glAccount}"/>
                                    </Column>
                                    <Column width="11rem">
                                        <Text text="{i18n>label.item.costCenter}"/>
                                    </Column>
                                    <Column minScreenWidth="Tablet" demandPopin="true">
                                        <Text text="{i18n>label.item.description}"/>
                                    </Column>
                                    <Column width="6rem" hAlign="Center">
                                        <Text text="{i18n>label.item.taxCode}"/>
                                    </Column>
                                    <Column width="10rem" hAlign="End">
                                        <Text text="{i18n>label.item.amount}"/>
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{detailView>itemNo}"/>
                                            <ObjectIdentifier
                                                title="{detailView>glAccount/name}"
                                                text="{detailView>glAccount_code}"/>
                                            <ObjectIdentifier
                                                title="{detailView>costCenter/name}"
                                                text="{detailView>costCenter_code}"/>
                                            <Text text="{detailView>itemDescription}"/>
                                            <Text text="{detailView>taxCode}"/>
                                            <ObjectNumber
                                                number="{
                                                    parts: [
                                                        {path: 'detailView>amount'},
                                                        {path: 'detailView>/data/currency_code'}
                                                    ],
                                                    formatter: '.formatter.formatCurrency'
                                                }"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Section 4: SAP Event Mesh Logs -->
            <uxap:ObjectPageSection titleUppercase="false" title="SAP Event Mesh Logs">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="Event Logs">
                        <uxap:blocks>
                            <Table
                                items="{detailView>/eventLogs}"
                                noDataText="No Event Mesh messages recorded yet.">
                                <columns>
                                    <Column width="14rem">
                                        <Text text="Event Name / Topic"/>
                                    </Column>
                                    <Column width="11rem">
                                        <Text text="Timestamp"/>
                                    </Column>
                                    <Column width="7rem" hAlign="Center">
                                        <Text text="Status"/>
                                    </Column>
                                    <Column>
                                        <Text text="Event Payload"/>
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <VBox>
                                                <Text text="{detailView>eventName}" class="sapUiTinyMarginBottom"/>
                                                <Text text="{detailView>topic}" subtle="true"/>
                                            </VBox>
                                            <Text text="{detailView>createdAt}"/>
                                            <ObjectStatus text="{detailView>status}" state="Success"/>
                                            <TextArea
                                                value="{detailView>payload}"
                                                editable="false"
                                                width="100%"
                                                rows="5"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Section 5: Integration Suite (CPI) Logs -->
            <uxap:ObjectPageSection titleUppercase="false" title="Integration Suite (CPI) Logs">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="CPI &amp; S/4HANA Logs">
                        <uxap:blocks>
                            <Table
                                items="{detailView>/integrationLogs}"
                                noDataText="No CPI integration logs recorded yet.">
                                <columns>
                                    <Column width="13rem">
                                        <Text text="Integration Step / Endpoint"/>
                                    </Column>
                                    <Column width="11rem">
                                        <Text text="Timestamp"/>
                                    </Column>
                                    <Column width="6rem" hAlign="Center">
                                        <Text text="Status"/>
                                    </Column>
                                    <Column>
                                        <Text text="Payloads"/>
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <VBox>
                                                <Text text="{detailView>step}" class="sapUiTinyMarginBottom"/>
                                                <Text text="{detailView>endpoint}" subtle="true"/>
                                            </VBox>
                                            <Text text="{detailView>createdAt}"/>
                                            <ObjectStatus
                                                text="{detailView>httpStatus} ({detailView>status})"
                                                state="{= ${detailView>status} === 'SUCCESS' ? 'Success' : 'Error' }"/>
                                            <VBox width="100%">
                                                <Label text="S/4HANA Request Payload:"/>
                                                <TextArea
                                                    value="{detailView>requestPayload}"
                                                    editable="false"
                                                    width="100%"
                                                    rows="4"/>
                                                <Label text="CPI Response:" class="sapUiTinyMarginTop"/>
                                                <TextArea
                                                    value="{detailView>responsePayload}"
                                                    editable="false"
                                                    width="100%"
                                                    rows="4"/>
                                            </VBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>
