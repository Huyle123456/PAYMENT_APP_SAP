<mvc:View
    controllerName="sap.payment.app.controller.Create"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <uxap:ObjectPageLayout
        id="objectPageLayoutCreate"
        showTitleInHeaderContent="true"
        showFooter="true"
        alwaysShowContentHeader="false"
        preserveHeaderStateOnScroll="false"
        isChildPage="true"
        busy="{createView>/busy}">

        <!-- Dynamic Header Title -->
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <Title text="{i18n>title.paymentRequest.create}" level="H2"/>
                </uxap:expandedHeading>

                <uxap:snappedHeading>
                    <Title text="{i18n>title.paymentRequest.create}"/>
                </uxap:snappedHeading>

                <uxap:expandedContent>
                    <Text text="Enter payment request details and cost allocation breakdown."/>
                </uxap:expandedContent>

                <uxap:snappedContent>
                    <Text text="Enter payment request details and cost allocation breakdown."/>
                </uxap:snappedContent>

                <uxap:navigationActions>
                    <Button
                        icon="sap-icon://nav-back"
                        tooltip="{i18n>btn.back}"
                        press=".onNavBack"/>
                </uxap:navigationActions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <!-- Header Content: Total Live Preview -->
        <uxap:headerContent>
            <FlexBox wrap="Wrap" fitContainer="true" alignItems="Stretch">
                <VBox class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                    <Label text="{i18n>label.paymentRequest.totalAmount}"/>
                    <ObjectNumber
                        number="{
                            parts: [
                                {path: 'createView>/formData/totalAmount'},
                                {path: 'createView>/formData/currency_code'}
                            ],
                            formatter: '.formatter.formatCurrency'
                        }"
                        state="Success"
                        emphasized="true"/>
                </VBox>
                <VBox class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                    <Label text="{i18n>label.paymentRequest.status}"/>
                    <ObjectStatus text="{i18n>status.draft}" state="None" icon="sap-icon://edit"/>
                </VBox>
            </FlexBox>
        </uxap:headerContent>

        <!-- Sections -->
        <uxap:sections>
            <!-- Section 1: General Information -->
            <uxap:ObjectPageSection titleUppercase="false" title="{i18n>title.paymentRequest.header}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="{i18n>title.paymentRequest.header}">
                        <uxap:blocks>
                            <form:SimpleForm
                                layout="ResponsiveGridLayout"
                                labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                                adjustLabelSpan="false"
                                emptySpanXL="2" emptySpanL="2" emptySpanM="0" emptySpanS="0"
                                columnsXL="2" columnsL="2" columnsM="1"
                                singleContainerFullSize="false">
                                <form:content>
                                    <core:Title text="Header Information"/>
                                    
                                    <!-- Description -->
                                    <Label text="{i18n>label.paymentRequest.description}" required="true"/>
                                    <Input
                                        value="{createView>/formData/description}"
                                        placeholder="e.g. Q3 Software License and Maintenance Subscription"/>

                                    <!-- Company Code (Master Data) -->
                                    <Label text="{i18n>label.paymentRequest.companyCode}" required="true"/>
                                    <Select
                                        selectedKey="{createView>/formData/companyCode_code}"
                                        items="{
                                            path: 'createView>/masterData/companyCodes'
                                        }">
                                        <core:Item key="{createView>code}" text="{createView>code} - {createView>name}"/>
                                    </Select>

                                    <!-- Vendor (Master Data) -->
                                    <Label text="{i18n>label.paymentRequest.vendor}" required="true"/>
                                    <Select
                                        selectedKey="{createView>/formData/vendor_code}"
                                        items="{
                                            path: 'createView>/masterData/vendors'
                                        }">
                                        <core:Item key="{createView>code}" text="{createView>code} - {createView>name}"/>
                                    </Select>

                                    <core:Title text="Payment Terms &amp; Dates"/>

                                    <!-- Request Date -->
                                    <Label text="{i18n>label.paymentRequest.requestDate}" required="true"/>
                                    <DatePicker
                                        value="{createView>/formData/requestDate}"
                                        valueFormat="yyyy-MM-dd"
                                        displayFormat="dd/MM/yyyy"/>

                                    <!-- Due Date -->
                                    <Label text="{i18n>label.paymentRequest.dueDate}" required="true"/>
                                    <DatePicker
                                        value="{createView>/formData/dueDate}"
                                        valueFormat="yyyy-MM-dd"
                                        displayFormat="dd/MM/yyyy"/>

                                    <!-- Payment Method -->
                                    <Label text="{i18n>label.paymentRequest.paymentMethod}"/>
                                    <Select
                                        selectedKey="{createView>/formData/paymentMethod_code}"
                                        items="{
                                            path: 'createView>/masterData/paymentMethods'
                                        }">
                                        <core:Item key="{createView>code}" text="{createView>code} - {createView>name}"/>
                                    </Select>

                                    <!-- Currency -->
                                    <Label text="{i18n>label.paymentRequest.currency}"/>
                                    <Select selectedKey="{createView>/formData/currency_code}">
                                        <core:Item key="VND" text="VND (Vietnamese Dong)"/>
                                        <core:Item key="USD" text="USD (US Dollar)"/>
                                        <core:Item key="EUR" text="EUR (Euro)"/>
                                        <core:Item key="JPY" text="JPY (Japanese Yen)"/>
                                    </Select>
                                </form:content>
                            </form:SimpleForm>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Section 2: Line Items -->
            <uxap:ObjectPageSection titleUppercase="false" title="{i18n>title.paymentRequest.items}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="Cost Allocation Breakdown">
                        <uxap:blocks>
                            <Table
                                id="createItemsTable"
                                items="{createView>/formData/items}"
                                noDataText="Add at least one line item.">
                                <headerToolbar>
                                    <Toolbar>
                                        <Title text="Items ({= ${createView>/formData/items}.length })" level="H4"/>
                                        <ToolbarSpacer/>
                                        <Button
                                            text="{i18n>btn.addItem}"
                                            icon="sap-icon://add"
                                            type="Emphasized"
                                            press=".onAddItemPress"/>
                                    </Toolbar>
                                </headerToolbar>
                                <columns>
                                    <Column width="4rem">
                                        <Text text="{i18n>label.item.itemNo}"/>
                                    </Column>
                                    <Column width="14rem">
                                        <Text text="{i18n>label.item.glAccount}"/>
                                    </Column>
                                    <Column width="14rem">
                                        <Text text="{i18n>label.item.costCenter}"/>
                                    </Column>
                                    <Column minScreenWidth="Tablet" demandPopin="true">
                                        <Text text="{i18n>label.item.description}"/>
                                    </Column>
                                    <Column width="10rem">
                                        <Text text="{i18n>label.item.amount}"/>
                                    </Column>
                                    <Column width="6rem">
                                        <Text text="{i18n>label.item.taxCode}"/>
                                    </Column>
                                    <Column width="4rem" hAlign="Center">
                                        <Text text="{i18n>label.item.actions}"/>
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{createView>itemNo}"/>
                                            <!-- G/L Account -->
                                            <Select
                                                width="100%"
                                                selectedKey="{createView>glAccount_code}"
                                                items="{
                                                    path: 'createView>/masterData/glAccounts'
                                                }">
                                                <core:Item key="{createView>code}" text="{createView>code} - {createView>name}"/>
                                            </Select>

                                            <!-- Cost Center -->
                                            <Select
                                                width="100%"
                                                selectedKey="{createView>costCenter_code}"
                                                items="{
                                                    path: 'createView>/masterData/costCenters'
                                                }">
                                                <core:Item key="{createView>code}" text="{createView>code} - {createView>name}"/>
                                            </Select>

                                            <!-- Item Description -->
                                            <Input
                                                value="{createView>itemDescription}"
                                                placeholder="Cost details"/>

                                            <!-- Amount -->
                                            <Input
                                                type="Number"
                                                value="{createView>amount}"
                                                liveChange=".onItemAmountChange"/>

                                            <!-- Tax Code -->
                                            <Input
                                                value="{createView>taxCode}"
                                                maxLength="2"/>

                                            <!-- Delete Item Button -->
                                            <Button
                                                icon="sap-icon://delete"
                                                type="Transparent"
                                                press=".onDeleteItemPress"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>

        <!-- Standard Fiori Semantic Footer -->
        <uxap:footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button
                    text="{i18n>btn.saveDraft}"
                    icon="sap-icon://save"
                    press=".onSaveDraftPress"/>
                <Button
                    text="{i18n>btn.submitApproval}"
                    type="Emphasized"
                    icon="sap-icon://paper-plane"
                    press=".onSubmitApprovalPress"/>
                <Button
                    text="{i18n>btn.cancel}"
                    press=".onCancelPress"/>
            </OverflowToolbar>
        </uxap:footer>
    </uxap:ObjectPageLayout>
</mvc:View>
