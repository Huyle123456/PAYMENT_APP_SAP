<mvc:View
    controllerName="sap.payment.app.controller.List"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core">

    <f:DynamicPage
        id="dynamicPageList"
        headerExpanded="true"
        showFooter="false"
        busy="{listView>/busy}">

        <!-- Dynamic Page Title -->
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>title.paymentRequest.list}" level="H2"/>
                </f:heading>
                <f:expandedContent>
                    <Text text="{i18n>appDescription}"/>
                </f:expandedContent>
                <f:snappedContent>
                    <Text text="{i18n>appDescription}"/>
                </f:snappedContent>
                <f:actions>
                    <Button
                        text="{i18n>btn.create}"
                        type="Emphasized"
                        icon="sap-icon://add"
                        press=".onCreatePress"/>
                    <Button
                        icon="sap-icon://refresh"
                        tooltip="{i18n>btn.refresh}"
                        press=".onRefresh"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <!-- Dynamic Page Header: Standard Fiori KPI Tiles -->
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <HBox wrap="Wrap" alignItems="Center">
                    <!-- Total Requests Tile -->
                    <GenericTile
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        header="{i18n>kpi.totalRequests}"
                        frameType="OneByOne">
                        <tileContent>
                            <TileContent>
                                <content>
                                    <NumericContent
                                        value="{listView>/stats/total}"
                                        icon="sap-icon://database"
                                        valueColor="Neutral"/>
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <!-- In Approval Tile -->
                    <GenericTile
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        header="{i18n>kpi.inApproval}"
                        frameType="OneByOne">
                        <tileContent>
                            <TileContent>
                                <content>
                                    <NumericContent
                                        value="{listView>/stats/inApproval}"
                                        icon="sap-icon://pending"
                                        valueColor="Critical"/>
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <!-- Approved Tile -->
                    <GenericTile
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        header="{i18n>kpi.approved}"
                        frameType="OneByOne">
                        <tileContent>
                            <TileContent>
                                <content>
                                    <NumericContent
                                        value="{listView>/stats/approved}"
                                        icon="sap-icon://sys-enter-2"
                                        valueColor="Good"/>
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <!-- Posted in S/4HANA Tile -->
                    <GenericTile
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        header="{i18n>kpi.postedS4}"
                        frameType="OneByOne">
                        <tileContent>
                            <TileContent>
                                <content>
                                    <NumericContent
                                        value="{listView>/stats/posted}"
                                        icon="sap-icon://accept"
                                        valueColor="Good"/>
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
                </HBox>
            </f:DynamicPageHeader>
        </f:header>

        <!-- Dynamic Page Content -->
        <f:content>
            <VBox>
                <!-- Filter bar & Status Tabs -->
                <IconTabBar
                    id="statusTabBar"
                    select=".onStatusFilterSelect"
                    headerBackgroundDesign="Transparent"
                    applyContentPadding="false">
                    <items>
                        <IconTabFilter key="ALL" text="{i18n>label.filter.all}" icon="sap-icon://database" count="{listView>/stats/total}"/>
                        <IconTabSeparator/>
                        <IconTabFilter key="DRAFT" text="{i18n>status.draft}" icon="sap-icon://edit"/>
                        <IconTabFilter key="IN_APPROVAL" text="{i18n>status.in_approval}" icon="sap-icon://pending" count="{listView>/stats/inApproval}"/>
                        <IconTabFilter key="APPROVED" text="{i18n>status.approved}" icon="sap-icon://sys-enter-2" count="{listView>/stats/approved}"/>
                        <IconTabFilter key="POSTED" text="{i18n>status.posted}" icon="sap-icon://accept" count="{listView>/stats/posted}"/>
                        <IconTabFilter key="REJECTED" text="{i18n>status.rejected}" icon="sap-icon://decline"/>
                    </items>
                </IconTabBar>

                <!-- Search and Table Toolbar -->
                <Toolbar class="sapUiTinyMarginTopBottom">
                    <SearchField
                        width="350px"
                        placeholder="{i18n>label.filter.search}"
                        search=".onSearch"
                        liveChange=".onSearch"/>
                    <ToolbarSpacer/>
                    <Text text="{= ${listView>/paymentRequests}.length + ' items'}"/>
                </Toolbar>

                <!-- Payment Requests Table -->
                <Table
                    id="paymentRequestsTable"
                    items="{
                        path: 'listView>/paymentRequests',
                        sorter: { path: 'createdAt', descending: true }
                    }"
                    growing="true"
                    growingThreshold="20"
                    noDataText="No payment requests found."
                    itemPress=".onItemPress">
                    <columns>
                        <Column width="11rem">
                            <Text text="{i18n>label.paymentRequest.requestNo}"/>
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true">
                            <Text text="{i18n>label.paymentRequest.vendor}"/>
                        </Column>
                        <Column minScreenWidth="Desktop" demandPopin="true">
                            <Text text="{i18n>label.paymentRequest.description}"/>
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" width="8rem">
                            <Text text="{i18n>label.paymentRequest.dueDate}"/>
                        </Column>
                        <Column width="9rem" hAlign="End">
                            <Text text="{i18n>label.paymentRequest.totalAmount}"/>
                        </Column>
                        <Column width="10rem" hAlign="Center">
                            <Text text="{i18n>label.paymentRequest.status}"/>
                        </Column>
                        <Column minScreenWidth="Desktop" demandPopin="true" width="10rem">
                            <Text text="{i18n>label.paymentRequest.sapSupplierInvoiceNo}"/>
                        </Column>
                        <Column width="7rem" hAlign="Center">
                            <Text text="Action"/>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Navigation">
                            <cells>
                                <!-- Request No -->
                                <ObjectIdentifier
                                    title="{listView>requestNo}"
                                    text="{listView>companyCode/name} ({listView>companyCode_code})"/>

                                <!-- Vendor -->
                                <VBox>
                                    <Text text="{listView>vendor/name}" class="sapUiTinyMarginBottom"/>
                                    <Text text="{listView>vendor_code}" subtle="true"/>
                                </VBox>

                                <!-- Description -->
                                <Text text="{listView>description}"/>

                                <!-- Due Date -->
                                <Text text="{
                                    path: 'listView>dueDate',
                                    formatter: '.formatter.formatDate'
                                }"/>

                                <!-- Total Amount -->
                                <ObjectNumber
                                    number="{
                                        parts: [
                                            {path: 'listView>totalAmount'},
                                            {path: 'listView>currency_code'}
                                        ],
                                        formatter: '.formatter.formatCurrency'
                                    }"
                                    state="Success"/>

                                <!-- Status -->
                                <ObjectStatus
                                    text="{
                                        path: 'listView>status',
                                        formatter: '.formatter.statusText'
                                    }"
                                    state="{
                                        path: 'listView>status',
                                        formatter: '.formatter.statusState'
                                    }"
                                    icon="{
                                        path: 'listView>status',
                                        formatter: '.formatter.statusIcon'
                                    }"/>

                                <!-- S4 Supplier Invoice -->
                                <VBox>
                                    <ObjectStatus
                                        visible="{= !!${listView>sapSupplierInvoiceNo} }"
                                        text="{listView>sapSupplierInvoiceNo}"
                                        state="Information"
                                        icon="sap-icon://supplier"/>
                                    <Text
                                        visible="{= !${listView>sapSupplierInvoiceNo} }"
                                        text="—"
                                        subtle="true"/>
                                </VBox>

                                <!-- Actions -->
                                <HBox justifyContent="Center">
                                    <Button
                                        visible="{= ${listView>status} === 'DRAFT' || ${listView>status} === 'REJECTED' }"
                                        icon="sap-icon://paper-plane"
                                        type="Emphasized"
                                        tooltip="{i18n>btn.submitApproval}"
                                        press=".onQuickSubmit"/>
                                    <Button
                                        icon="sap-icon://simulate"
                                        type="Transparent"
                                        tooltip="{i18n>btn.simulateFullFlow}"
                                        press=".onQuickSimulate"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
